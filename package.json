{
  "name": "zellavora-nexus-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback",
    "db:check": "tsx scripts/db-check.ts",
    "rls:audit": "tsx scripts/rls-audit.ts",
    "openapi:gen": "tsx scripts/gen-openapi.ts",
    "openapi:check": "tsx scripts/gen-openapi.ts --check",
    "docs:erd": "tsx scripts/gen-erd.ts",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "readiness": "tsx scripts/readiness-check.ts",
    "verify": "npm run lint && npm run typecheck && npm run db:check && npm run rls:audit && npm run docs:check && npm test",
    "docs:trace": "tsx scripts/gen-traceability.ts",
    "smtp:check": "tsx scripts/smtp-check.ts",
    "docs:artifacts": "tsx scripts/gen-docs.ts",
    "docs:lint": "spectral lint docs/openapi.json docs/openapi.full.json -r .spectral.yaml --fail-severity=error",
    "docs:sdk": "npm --prefix sdk run generate && npm --prefix sdk run typecheck",
    "docs:build": "npm run openapi:gen && npm run docs:artifacts && npm run docs:sdk",
    "docs:check": "npm run openapi:check && tsx scripts/gen-docs.ts --check && npm run docs:lint",
    "docs:db-schemas": "tsx scripts/gen-db-schemas.ts",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@vercel/functions": "^3.10.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.2",
    "redoc": "^2.5.0",
    "sanitize-html": "^2.18.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "openapi-to-postmanv2": "^6.4.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  },
  "scripts/docs:all": "x",
  "overrides": {
    "uuid": "^14.0.3"
  }
}
