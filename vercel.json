{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel && node -e \"const f=require('fs');f.mkdirSync('public',{recursive:true});f.writeFileSync('public/robots.txt','User-agent: * Disallow: /')\"",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/{redoc,swagger-ui-dist}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/tick",
      "schedule": "0 3 * * *"
    }
  ],
  "outputDirectory": "public"
}
